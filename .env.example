# Copy to .env (or export these directly) and fill in real values for any
# environment beyond local dev. application.yml already has working
# defaults for local dev baked in via ${VAR:default} placeholders, so none
# of these are required just to run `mvn spring-boot:run` on this machine
# Ã¢â‚¬â€ they exist so a real deployment has something to override.
#
# Per the Phase 1 dev brief's config convention: .env files are never
# committed, only this .env.example is. Secrets come from environment
# variables at boot Ã¢â‚¬â€ standard Spring externalized config, nothing here is
# ever read from a committed file.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/ulwembu
DB_USERNAME=ulwembu
DB_PASSWORD=change-me

# --- Tenant JWT (staff/org-admin logins) ---
# Generate with: openssl rand -base64 32 Ã¢â‚¬â€ HS256 needs 256 bits of key
# material, and a short human-typed secret makes JwtService throw
# WeakKeyException at startup on purpose.
JWT_SECRET=change-me

# --- Platform JWT (seller/internal-team logins) ---
# A separate key from JWT_SECRET, deliberately Ã¢â‚¬â€ a compromised tenant
# signing key shouldn't grant platform access, and vice versa.
PLATFORM_JWT_SECRET=change-me

# --- Patient JWT (patient portal logins) ---
# A third separate key — same reasoning as PLATFORM_JWT_SECRET above.
PATIENT_JWT_SECRET=change-me

# --- Secrets-at-rest encryption key ---
# AES-256 key, base64-encoded (32 raw bytes) Ã¢â‚¬â€ generate with:
# openssl rand -base64 32
# Used by core/common/SecretEncryptor to encrypt any secret this app stores
# and must later read back in plaintext (as opposed to a login password,
# which BCryptPasswordEncoder only ever hashes one-way). Today that's just
# a tenant's own SMTP password (OrganizationMailSettings, Settings > Email
# in the tenant app) Ã¢â‚¬â€ it has to come back out in plaintext to actually
# authenticate against a mail server.
ORG_SECRETS_ENCRYPTION_KEY=change-me

# --- CORS ---
CORS_ALLOWED_ORIGINS=https://app.yourcompany.example

# --- First platform operator (local/dev bootstrap only) ---
# PlatformOperatorBootstrap (@Profile("dev")) creates exactly one operator
# from these on startup if none exists yet. Not meant for production Ã¢â‚¬â€ see
# that class's own why-note for what a real deployment needs instead.
PLATFORM_BOOTSTRAP_EMAIL=ops@yourcompany.example
PLATFORM_BOOTSTRAP_PASSWORD=change-me
PLATFORM_BOOTSTRAP_FIRST_NAME=Platform
PLATFORM_BOOTSTRAP_LAST_NAME=Operator

# --- S3-compatible storage (staff photo uploads) ---
STORAGE_REGION=af-south-1
STORAGE_BUCKET_NAME=your-bucket-name
STORAGE_PUBLIC_BASE_URL=https://your-bucket-name.s3.af-south-1.amazonaws.com
# Both S3 and SNS SMS use the AWS default credential chain (IAM role in
# production, or AWS_ACCESS_KEY_ID/AWS_SECRET_ACCESS_KEY/AWS_PROFILE locally),
# never credentials in app.* config. Production should use an IAM role.
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
# Set this when using temporary AWS credentials.
AWS_SESSION_TOKEN=

# --- AWS SNS SMS ---
# SMS uses the AWS default credential chain configured above. Grant the
# runtime identity sns:Publish in this region before enabling SMS.
AWS_SMS_REGION=eu-west-1
AWS_SMS_ENABLED=false

# --- WhatsApp Cloud API ---
# Requires a Meta-approved utility template and explicit patient opt-in.
META_WHATSAPP_ACCESS_TOKEN=change-me
META_WHATSAPP_PHONE_NUMBER_ID=change-me
META_WHATSAPP_API_VERSION=v26.0
META_WHATSAPP_QUEUE_TEMPLATE_NAME=queue_turn_approaching
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_WHATSAPP_ENABLED=false
# Optional per-template overrides. Leave the defaults unless a template's
# approved name in Meta differs from the catalogue name.
META_WHATSAPP_TEMPLATE_MEDICATION_READY=ulwembu_medication_ready
META_WHATSAPP_TEMPLATE_MEDICATION_COLLECTION_REMINDER=ulwembu_medication_collection_reminder
META_WHATSAPP_TEMPLATE_MEDICATION_COLLECTION_OVERDUE=ulwembu_medication_collection_overdue
META_WHATSAPP_TEMPLATE_MEDICATION_PARTIALLY_READY=ulwembu_medication_partially_ready
META_WHATSAPP_TEMPLATE_MEDICATION_DELAYED=ulwembu_medication_delayed
META_WHATSAPP_TEMPLATE_MEDICATION_COLLECTED=ulwembu_medication_collected
META_WHATSAPP_TEMPLATE_MEDICATION_COLLECTION_CHANGED=ulwembu_medication_collection_changed
META_WHATSAPP_TEMPLATE_REPEAT_PRESCRIPTION_REVIEW=ulwembu_repeat_prescription_review
META_WHATSAPP_TEMPLATE_APPOINTMENT_CONFIRMED=ulwembu_appointment_confirmed
META_WHATSAPP_TEMPLATE_APPOINTMENT_REMINDER=ulwembu_appointment_reminder
META_WHATSAPP_TEMPLATE_APPOINTMENT_TODAY=ulwembu_appointment_today
META_WHATSAPP_TEMPLATE_APPOINTMENT_RESCHEDULED=ulwembu_appointment_rescheduled
META_WHATSAPP_TEMPLATE_APPOINTMENT_CANCELLED=ulwembu_appointment_cancelled
META_WHATSAPP_TEMPLATE_APPOINTMENT_MISSED=ulwembu_appointment_missed
META_WHATSAPP_TEMPLATE_APPOINTMENT_REQUEST_RECEIVED=ulwembu_appointment_request_received
META_WHATSAPP_TEMPLATE_APPOINTMENT_WAITLIST_OFFER=ulwembu_appointment_waitlist_offer
META_WHATSAPP_TEMPLATE_VISIT_CHECKED_IN=ulwembu_visit_checked_in
META_WHATSAPP_TEMPLATE_QUEUE_CALLED=ulwembu_queue_called
META_WHATSAPP_TEMPLATE_FOLLOW_UP_REQUESTED=ulwembu_follow_up_requested
META_WHATSAPP_TEMPLATE_RESULTS_AVAILABLE=ulwembu_results_available
META_WHATSAPP_TEMPLATE_SECURE_MESSAGE=ulwembu_secure_message
META_WHATSAPP_TEMPLATE_PATIENT_WELCOME=ulwembu_patient_welcome
META_WHATSAPP_TEMPLATE_PATIENT_VERIFICATION_CODE=ulwembu_patient_verification_code
META_WHATSAPP_TEMPLATE_PASSWORD_RESET_CODE=ulwembu_password_reset_code
META_WHATSAPP_TEMPLATE_PASSWORD_CHANGED=ulwembu_password_changed
META_WHATSAPP_TEMPLATE_PATIENT_TRANSFER=ulwembu_patient_transfer
META_WHATSAPP_TEMPLATE_STAFF_ACCOUNT_CREATED=ulwembu_staff_account_created
META_WHATSAPP_TEMPLATE_STAFF_PASSWORD_RESET=ulwembu_staff_password_reset
META_WHATSAPP_TEMPLATE_PRESCRIBER_QUERY=ulwembu_prescriber_query
META_WHATSAPP_TEMPLATE_ORGANISATION_ADMIN_WELCOME=ulwembu_organisation_admin_welcome
META_WHATSAPP_TEMPLATE_PLATFORM_OPERATOR_WELCOME=ulwembu_platform_operator_welcome
META_WHATSAPP_TEMPLATE_NEW_SIGN_IN=ulwembu_new_sign_in

# --- SMTP (outbound application emails) ---
# Any SMTP provider works here. For Amazon SES specifically: use its SMTP
# interface (email-smtp.<region>.amazonaws.com:587), not the plain AWS
# access key/secret used by STORAGE_* below Ã¢â‚¬â€ SES SMTP needs its own
# username/password, generated from the SES console under SMTP settings >
# Create SMTP credentials (this also mints a dedicated IAM user scoped to
# ses:SendRawEmail only). The address in NOTIFICATIONS_FROM_ADDRESS must be
# a verified SES identity in that same region, and the account must be out
# of SES sandbox mode to send to recipients that aren't individually
# verified.
SMTP_HOST=smtp.yourprovider.example
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
NOTIFICATIONS_FROM_ADDRESS=no-reply@yourcompany.example

# --- Microsoft 365 work mailbox via Microsoft Graph (OAuth) ---
# In Entra, register a single-tenant app, grant Microsoft Graph Application
# permission Mail.Send, and have an admin grant consent. Restrict the app to
# the intended sender mailbox with your Exchange admin before production use.
# Set NOTIFICATIONS_PROVIDER=microsoft-graph to select this transport.
NOTIFICATIONS_PROVIDER=smtp
MS_GRAPH_TENANT_ID=change-me
MS_GRAPH_CLIENT_ID=change-me
MS_GRAPH_CLIENT_SECRET=change-me
# Every outbound email is also written to this directory before the real
# send is attempted Ã¢â‚¬â€ see core/notification/EmailService.java.
NOTIFICATIONS_CAPTURE_DIR=./data/emails

# --- Frontend ---
# Canonical URL put into emails (e.g. "sign in here"). Deliberately not
# reused from CORS_ALLOWED_ORIGINS, which can list more than one origin.
FRONTEND_BASE_URL=https://app.yourcompany.example

# --- Backend's own public origin ---
# Used only to build the Microsoft SSO redirect_uri (MicrosoftSsoService)
# — must be this app's real, internet-reachable origin, since it's the one
# value every organization's own Azure AD app registration needs
# configured as its redirect URI (Settings > Single sign-on documents the
# exact value to paste there).
BACKEND_BASE_URL=https://api.yourcompany.example
