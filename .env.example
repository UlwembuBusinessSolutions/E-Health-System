# ==============================
# DATABASE
# ==============================
DB_URL=jdbc:postgresql://localhost:5432/ulwembu
DB_USERNAME=postgres
DB_PASSWORD=Linhle@12

# ==============================
# TENANT JWT
# ==============================
# Use a long random value.
JWT_SECRET=REPLACE_WITH_A_LONG_RANDOM_TENANT_JWT_SECRET

# ==============================
# PLATFORM JWT
# ==============================
# IMPORTANT: This MUST be different from JWT_SECRET.
PLATFORM_JWT_SECRET=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_PLATFORM_JWT_SECRET

# ==============================
# CORS - LOCAL DEVELOPMENT
# ==============================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================
# FIRST PLATFORM OPERATOR
# ==============================
# PlatformOperatorBootstrap runs with the dev profile
# and creates this operator if no platform operator exists.
PLATFORM_BOOTSTRAP_EMAIL=ops@ulwembu.example
PLATFORM_BOOTSTRAP_PASSWORD=Linhle@12
PLATFORM_BOOTSTRAP_FIRST_NAME=Platform
PLATFORM_BOOTSTRAP_LAST_NAME=Operator

# ==============================
# S3 / STORAGE
# ==============================
STORAGE_REGION=af-south-1
STORAGE_BUCKET_NAME=your-bucket-name
STORAGE_PUBLIC_BASE_URL=https://your-bucket-name.s3.af-south-1.amazonaws.com

# ==============================
# SMTP
# ==============================
SMTP_HOST=smtp.yourprovider.example
SMTP_PORT=587
SMTP_USERNAME=change-me
SMTP_PASSWORD=change-me
NOTIFICATIONS_FROM_ADDRESS=no-reply@yourcompany.example
NOTIFICATIONS_CAPTURE_DIR=./data/emails

# ==============================
# FRONTEND
# ==============================
FRONTEND_BASE_URL=http://localhost:5173